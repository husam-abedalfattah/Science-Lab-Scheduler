# Copy to .env.local and fill in.

# Password for the in-app admin panel.
#
# This gates the admin UI only. Anything shipped to the browser is readable by
# the user, so it is a convenience lock, not a security boundary -- real
# enforcement belongs in firestore.rules.
#
# If unset, the app falls back to the historical default ("admin123") and warns
# in the dev console. Set it before deploying.
VITE_ADMIN_PASSWORD="change-me"
